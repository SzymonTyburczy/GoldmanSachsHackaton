# Copy to .env (make setup does this when .env is missing) and fill in locally.
# Never commit .env and never paste these values into an AI assistant.

# Local SQLite database, created on startup.
CONTROLPROOF_DB_PATH=var/controlproof.sqlite3

# Demo identities (A2): long random bearer tokens, mapped to identities on the server.
CONTROLPROOF_TOKEN_ANALYST_A=
CONTROLPROOF_TOKEN_REVIEWER_A=
CONTROLPROOF_TOKEN_ADMIN=

# Provider keys (B1), read only by backend adapters.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
